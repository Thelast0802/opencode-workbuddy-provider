{
  "name": "opencode-workbuddy-provider",
  "version": "1.2.0",
  "description": "WorkBuddy & CodeBuddy Provider for OpenCode (with Hardened Protocol & Anti-Ban Protection)",
  "author": "Thelast0802",
  "license": "MIT",
  "main": "service/index.js",
  "bin": {
    "opencode-workbuddy": "service/index.js"
  },
  "scripts": {
    "start": "node service/index.js",
    "login": "node service/index.js --login",
    "test": "node test-hardening.js && node test-e2e.js",
    "build": "./build.sh"
  },
  "keywords": [
    "opencode",
    "opencode-provider",
    "openchamber",
    "workbuddy",
    "codebuddy",
    "deepseek",
    "thinking"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Thelast0802/opencode-workbuddy-provider.git"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.22.0"
    },
    "contributes": {
      "panel": {
        "id": "workbuddy",
        "name": "WorkBuddy 国际版",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "service": {
        "entry": "service/index.js",
        "runtime": "host"
      },
      "capabilities": [
        "prompt",
        "sessions"
      ]
    }
  }
}
